<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#eef1ef">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        tools:context=".MainActivity">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Live Sensor Readings &#8212; Lifecycle &amp; Interpretation"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#174d43"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ICS 2300 &#8212; Lab 06"
            android:textSize="14sp"
            android:textColor="#68736f"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <!-- Experiment Question -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardElevation="4dp"
            app:cardCornerRadius="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Experiment Question"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#174d43"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tvExperimentQuestion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="How does ambient light intensity (lux) change across three controlled conditions: (1) sensor covered, (2) normal indoor lighting, (3) direct flashlight exposure?"
                    android:textSize="14sp"
                    android:textColor="#202b29"
                    android:lineSpacingMultiplier="1.3" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Sensor Info -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardElevation="4dp"
            app:cardCornerRadius="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Sensor Information"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#174d43"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Sensor:"
                        android:textStyle="bold"
                        android:textSize="14sp" />
                    <TextView
                        android:id="@+id/tvSensorName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Light Sensor (TYPE_LIGHT)"
                        android:textSize="14sp"
                        android:gravity="end" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Unit:"
                        android:textStyle="bold"
                        android:textSize="14sp" />
                    <TextView
                        android:id="@+id/tvSensorUnit"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="lux"
                        android:textSize="14sp"
                        android:gravity="end" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Status:"
                        android:textStyle="bold"
                        android:textSize="14sp" />
                    <TextView
                        android:id="@+id/tvSensorStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Checking..."
                        android:textSize="14sp"
                        android:gravity="end"
                        android:textColor="#477f91" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Data Source:"
                        android:textStyle="bold"
                        android:textSize="14sp" />
                    <TextView
                        android:id="@+id/tvDataSource"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Measured"
                        android:textSize="14sp"
                        android:gravity="end"
                        android:textColor="#174d43" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Live Reading -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardElevation="4dp"
            app:cardCornerRadius="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Live Reading"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#174d43"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Raw Value:"
                        android:textStyle="bold"
                        android:textSize="14sp" />
                    <TextView
                        android:id="@+id/tvRawValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="&#8212; lux"
                        android:textSize="14sp"
                        android:gravity="end"
                        android:textColor="#202b29" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Smoothed (EMA &#945;=0.3):"
                        android:textStyle="bold"
                        android:textSize="14sp" />
                    <TextView
                        android:id="@+id/tvSmoothedValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="&#8212; lux"
                        android:textSize="14sp"
                        android:gravity="end"
                        android:textColor="#174d43" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Timestamp:"
                        android:textStyle="bold"
                        android:textSize="14sp" />
                    <TextView
                        android:id="@+id/tvTimestamp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="&#8212;"
                        android:textSize="14sp"
                        android:gravity="end"
                        android:textColor="#68736f" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/progressLight"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="12dp"
                    android:max="10000"
                    android:progress="0"
                    android:progressTint="#174d43"
                    android:progressBackgroundTint="#e2eeea" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Lifecycle Controls -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardElevation="4dp"
            app:cardCornerRadius="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Lifecycle Controls"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#174d43"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Listener State:"
                        android:textStyle="bold"
                        android:textSize="14sp" />
                    <TextView
                        android:id="@+id/tvListenerState"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Unregistered"
                        android:textSize="14sp"
                        android:gravity="end"
                        android:textColor="#bdcbc6" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Lifecycle Phase:"
                        android:textStyle="bold"
                        android:textSize="14sp" />
                    <TextView
                        android:id="@+id/tvLifecyclePhase"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="onCreate"
                        android:textSize="14sp"
                        android:gravity="end"
                        android:textColor="#68736f" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="8dp">
                    <Button
                        android:id="@+id/btnRegister"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:text="Register Listener"
                        android:backgroundTint="#174d43"
                        android:textColor="#fff" />
                    <Button
                        android:id="@+id/btnUnregister"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="Unregister Listener"
                        android:backgroundTint="#bdcbc6"
                        android:textColor="#202b29" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Observation Table -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardElevation="4dp"
            app:cardCornerRadius="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Observation Table (3 Controlled Conditions)"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#174d43"
                    android:layout_marginBottom="12dp" />

                <TableLayout
                    android:id="@+id/tableObservations"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stretchColumns="*"
                    android:shrinkColumns="*">

                    <TableRow android:background="#e2eeea">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="8dp"
                            android:text="Condition"
                            android:textStyle="bold"
                            android:textSize="12sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="8dp"
                            android:text="Raw (lux)"
                            android:textStyle="bold"
                            android:textSize="12sp"
                            android:gravity="center" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="8dp"
                            android:text="Smoothed (lux)"
                            android:textStyle="bold"
                            android:textSize="12sp"
                            android:gravity="center" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="8dp"
                            android:text="Timestamp"
                            android:textStyle="bold"
                            android:textSize="12sp"
                            android:gravity="center" />
                    </TableRow>

                    <TableRow>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="8dp"
                            android:text="1. Covered"
                            android:textSize="12sp" />
                        <TextView
                            android:id="@+id/tvObs1Raw"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="8dp"
                            android:text="&#8212;"
                            android:textSize="12sp"
                            android:gravity="center" />
                        <TextView
                            android:id="@+id/tvObs1Smooth"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="8dp"
                            android:text="&#8212;"
                            android:textSize="12sp"
                            android:gravity="center" />
                        <TextView
                            android:id="@+id/tvObs1Time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="8dp"
                            android:text="&#8212;"
                            android:textSize="12sp"
                            android:gravity="center" />
                    </TableRow>

                    <TableRow android:background="#fafafa">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="8dp"
                            android:text="2. Indoor Light"
                            android:textSize="12sp" />
                        <TextView
                            android:id="@+id/tvObs2Raw"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="8dp"
                            android:text="&#8212;"
                            android:textSize="12sp"
                            android:gravity="center" />
                        <TextView
                            android:id="@+id/tvObs2Smooth"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="8dp"
                            android:text="&#8212;"
                            android:textSize="12sp"
                            android:gravity="center" />
                        <TextView
                            android:id="@+id/tvObs2Time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="8dp"
                            android:text="&#8212;"
                            android:textSize="12sp"
                            android:gravity="center" />
                    </TableRow>

                    <TableRow>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="8dp"
                            android:text="3. Flashlight"
                            android:textSize="12sp" />
                        <TextView
                            android:id="@+id/tvObs3Raw"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="8dp"
                            android:text="&#8212;"
                            android:textSize="12sp"
                            android:gravity="center" />
                        <TextView
                            android:id="@+id/tvObs3Smooth"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="8dp"
                            android:text="&#8212;"
                            android:textSize="12sp"
                            android:gravity="center" />
                        <TextView
                            android:id="@+id/tvObs3Time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="8dp"
                            android:text="&#8212;"
                            android:textSize="12sp"
                            android:gravity="center" />
                    </TableRow>
                </TableLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp"
                    android:gravity="center">
                    <Button
                        android:id="@+id/btnRecordObs1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:text="Record Covered"
                        android:backgroundTint="#477f91"
                        android:textColor="#fff"
                        android:textSize="12sp" />
                    <Button
                        android:id="@+id/btnRecordObs2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:layout_marginStart="4dp"
                        android:text="Record Indoor"
                        android:backgroundTint="#174d43"
                        android:textColor="#fff"
                        android:textSize="12sp" />
                    <Button
                        android:id="@+id/btnRecordObs3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:text="Record Flashlight"
                        android:backgroundTint="#68736f"
                        android:textColor="#fff"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Analysis &amp; Interpretation -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardElevation="4dp"
            app:cardCornerRadius="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Analysis &amp; Interpretation"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#174d43"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/tvAnalysis"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Run the experiment to populate observations, then tap 'Generate Analysis' for interpretation."
                    android:textSize="13sp"
                    android:textColor="#202b29"
                    android:lineSpacingMultiplier="1.4" />

                <Button
                    android:id="@+id/btnGenerateAnalysis"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_gravity="center"
                    android:text="Generate Analysis"
                    android:backgroundTint="#174d43"
                    android:textColor="#fff" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Technical Notes -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardElevation="4dp"
            app:cardCornerRadius="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Technical Notes"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#174d43"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/tvTechnicalNotes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="\u2022 Sampling delay requested: SENSOR_DELAY_NORMAL (~200ms, but not guaranteed)\n\u2022 Smoothing: Exponential Moving Average (EMA) with \u03b1=0.3\n\u2022 Battery: Continuous listening at NORMAL rate ~1-3% per hour\n\u2022 Missing sensor: App shows 'Unavailable' and disables controls\n\u2022 Background: Listener unregistered in onPause, re-registered in onResume\n\u2022 Rotation: Values retained via ViewModel / savedInstanceState"
                    android:textSize="12sp"
                    android:textColor="#68736f"
                    android:lineSpacingMultiplier="1.5" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Footer -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lab 06 &#8212; Live Sensor Readings, Lifecycle and Interpretation"
            android:textSize="11sp"
            android:textColor="#7a8580"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp" />

    </LinearLayout>
</ScrollView>